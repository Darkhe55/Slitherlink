{
  "name": "shuhui-slitherlink",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "audit": "esbuild scripts/logic-audit.mts --bundle --format=esm --platform=node --outfile=scripts/logic-audit.mjs && node scripts/logic-audit.mjs",
    "logic-test": "esbuild scripts/logic-test.mts --bundle --format=esm --platform=node --outfile=scripts/logic-test.mjs && node scripts/logic-test.mjs",
    "import-image": "node scripts/import-image.mjs",
    "ocr-board": "node scripts/ocr-board.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
